{
  "name": "bus-approach-ar",
  "version": "0.2.0",
  "description": "公共交通オープンデータチャレンジ2026 — バス接近AR（Even G2）",
  "scripts": {
    "board": "tsx scripts/board-cli.ts",
    "rt:audit": "tsx scripts/rt-audit.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "app:dev": "LAN_IP=$(./scripts/lan-ip.sh) vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:qr": "evenhub qr --url \"http://$(./scripts/lan-ip.sh):5179\"",
    "app:pack": "npm run app:build && evenhub pack app/app.json dist/app -o dist/bus-approach-ar.ehpk --sdk-ver 0.0.15",
    "proxy:synth": "npx cdk synth KawasakiBusProxyStack -c appKey=synth-check --quiet",
    "proxy:deploy": "./scripts/deploy-proxy.sh",
    "build:all": "NODE_OPTIONS=--max-old-space-size=6144 tsx scripts/build-all.ts",
    "stops:upload": "./scripts/upload-stops.sh"
  },
  "type": "module",
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.4",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "private": true
}
